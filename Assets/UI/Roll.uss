/* Layout and component styles for the Roll screen. Colours come from the theme (Tavern.uss). */

.safe-area { flex-grow: 1; } /* padded at runtime by the device's safe area */

.screen {
    flex-grow: 1;
    padding: 8px 10px 8px 10px;
}

.lbl {
    margin: 0;
    padding: 0;
    color: var(--text);
    -unity-text-align: middle-left;
}

/* ---------- tab bar (bottom; the Roll tab sits in the middle, larger and raised) ---------- */
.tabbar {
    flex-direction: row;
    flex-shrink: 0;
    height: 48px;
    margin-top: 28px; /* room for the raised Roll tab */
    padding: 2px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 24px;
}
.tab {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: center;
    align-items: center;
    border-radius: 20px;
}
.tab--active { background-color: var(--accent); }
.tab__text {
    color: var(--muted);
    font-size: 14px;
    -unity-text-align: middle-center;
}
.tab--active .tab__text {
    color: var(--accent-ink);
    -unity-font-style: bold;
}
.tab--roll {
    flex-grow: 0;
    flex-basis: auto;
    align-self: flex-start;
    width: 76px;
    height: 70px;
    margin-top: -26px; /* raises it above the bar */
    border-radius: 35px;
    border-width: 3px;
    border-color: var(--panel);
    background-color: var(--panel-edge);
}
.tab--roll.tab--active { background-color: var(--accent); }
.tab__text--roll {
    font-size: 18px;
    -unity-font-style: bold;
}

.page {
    flex-grow: 1;
    margin-bottom: 4px;
}

/* ---------- set headers ---------- */
.headers { flex-shrink: 0; }

/* two rows: caption + formula on the left, total and the buttons on the right; the breakdown runs under all of it */
.set-header {
    flex-shrink: 0;
    height: 60px;
    margin-bottom: 4px;
    padding: 2px 6px 2px 14px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 20px;
}
.set-header--off { opacity: 0.55; }
.set-header__top {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 38px;
}
.set-header__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.caption {
    font-size: 11px;
    color: var(--muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.formula {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.total {
    min-width: 36px;
    margin: 0 6px 0 4px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}
.total--nat20 { color: var(--accent); }
.total--nat1 { color: var(--adv-d); }
.breakdown {
    height: 15px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.switch {
    width: 46px;
    height: 28px;
    margin-left: 4px;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: var(--off);
}
.switch--on { background-color: var(--accent); }
.switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--text);
}
.switch--on .switch__knob {
    left: 21px;
    background-color: var(--accent-ink);
}

.adv-btn {
    width: 38px;
    height: 38px;
    margin-left: 4px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    --die-fill: var(--adv-n);
    --die-edge: var(--adv-n-edge);
    --die-ink: var(--adv-n-ink);
}
.adv-btn--a {
    --die-fill: var(--adv-a);
    --die-edge: var(--adv-a-edge);
    --die-ink: var(--adv-a-ink);
}
.adv-btn--d {
    --die-fill: var(--adv-d);
    --die-edge: var(--adv-d-edge);
    --die-ink: var(--adv-d-ink);
}
.adv-btn .die-icon {
    width: 34px;
    height: 34px;
}

.mod {
    height: 30px;
    min-width: 42px;
    margin-left: 4px;
    padding: 0 8px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-width: 1.5px;
    border-color: var(--accent);
    border-radius: 15px;
}
.mod__text {
    color: var(--accent);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.mod.pressed { background-color: var(--btn-edge); }

.hide-btn {
    width: 34px;
    height: 38px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    color: var(--text);
}
.hide-btn__icon {
    width: 20px;
    height: 20px;
    color: var(--text);
}

/* ---------- tray area (3D tray shows through; tapping it rethrows) ---------- */
.tray-wrap {
    flex-grow: 1;
    margin-bottom: 6px;
}
.tray-area { flex-grow: 1; }
.toast {
    position: absolute;
    top: 8px;
    left: 24px;
    right: 24px;
    padding: 8px 12px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--adv-d-edge);
    border-radius: 14px;
    font-size: 14px;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.toast--show { opacity: 1; }

/* ---------- pinned preset chips ---------- */
/* floats over the bottom edge of the tray, so the tray keeps its height */
.chips {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 10px;
    flex-grow: 0;
    height: 46px;
}
.chip {
    flex-shrink: 0;
    max-width: 170px;
    height: 42px;
    margin-right: 6px;
    padding: 0 12px;
    justify-content: center;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 14px;
}
.chip.pressed { background-color: var(--btn-edge); }
.chip__text {
    color: var(--accent);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.chip__formula {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- action bar ---------- */
.actions {
    flex-direction: row;
    flex-shrink: 0;
    height: 44px;
    margin-bottom: 4px;
}
.action {
    height: 44px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 22px;
}
.action--ghost {
    width: 98px;
    margin-right: 8px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
}
.action--primary {
    flex-grow: 1;
    background-color: var(--accent);
    border-width: 2px;
    border-color: var(--btn-edge);
}
.action--disabled { opacity: 0.45; }
.action.pressed { opacity: 0.8; }
.action__text {
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 6px;
}
.action__text--primary {
    font-size: 22px;
    margin-left: 0;
    color: var(--accent-ink);
    -unity-text-align: middle-center;
}
.action__icon {
    width: 20px;
    height: 20px;
    color: var(--text);
}

/* ---------- dice rows ---------- */
.rows { flex-shrink: 0; }
.dice-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 52px;
    margin-top: 6px;
}
.dice-row__bar {
    width: 7px;
    height: 42px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: var(--atk);
}
.dice-row--dmg .dice-row__bar { background-color: var(--dmg); }

.dice-row--atk .die-icon {
    --die-fill: var(--atk);
    --die-edge: var(--atk-edge);
    --die-ink: var(--atk-ink);
}
.dice-row--dmg .die-icon {
    --die-fill: var(--dmg);
    --die-edge: var(--dmg-edge);
    --die-ink: var(--dmg-ink);
}

.die-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 48px;
    margin: 0 2px;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: var(--btn-edge);
    border-radius: 12px;
    background-color: var(--btn);
}
.die-btn.pressed { background-color: var(--panel); }
.die-btn__plus {
    width: 22px;
    height: 22px;
    color: var(--muted);
}
.die-icon {
    width: 38px;
    height: 38px;
}
.die-icon__text {
    position: absolute;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--die-ink);
}
/* a die with a picture from its dice set's atlas: the picture replaces the polygon, the dN text stays on top of it */
.die-icon--sprite {
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
}
.die-icon--sprite .die-icon__text {
    color: var(--text);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.badge {
    position: absolute;
    top: -6px;
    right: -3px;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
    background-color: var(--accent);
}
.badge__text {
    color: var(--accent-ink);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.badge--flash {
    background-color: var(--adv-d);
    scale: 1.3 1.3;
}

/* ---------- "+" picker: the die types that are not on the row yet ---------- */
.picker-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
/* the dice take the colours of the row class that Show adds (dice-row--atk) */
.picker {
    position: absolute;
    flex-direction: row;
    margin-bottom: 8px;
    padding: 4px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 14px;
}
.picker .die-btn {
    flex-grow: 0;
    flex-basis: auto;
    width: 50px;
}

/* ---------- press-and-slide overlay ---------- */
.slider-track {
    position: absolute;
    width: 28px;
    translate: -50% 0;
    background-color: rgba(26, 15, 8, 0.85);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 14px;
}
.slider-bubble {
    position: absolute;
    translate: -50% -50%;
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    background-color: var(--accent);
    border-width: 2px;
    border-color: var(--btn-edge);
}
.slider-bubble__text {
    color: var(--accent-ink);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
