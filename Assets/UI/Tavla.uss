/* Armenian Tavla theme: walnut panels with a red line and apricot highlights, like a backgammon board; Alegreya SC headings, Alegreya Sans text.
   ThemeApplier adds this sheet last, so where a rule has the same specificity as one in Roll.uss / Pages.uss, this one wins. */
:root {
    --text: #fbf0dc;
    --muted: #d9b98a;
    --accent: #e8872b;
    --accent-ink: #2a1206;
    --off: #8a6a4a;
    --panel: #4c2818;
    --panel-edge: #a3202f;
    --bg: #2a150c;
    --btn: #4c2e1a;
    --btn-edge: #c9a24a;
    --scrim: rgba(34, 16, 10, 0.9);

    --atk: #fbf0dc;
    --atk-ink: #5a1c1c;
    --atk-edge: #a3202f;
    --dmg: #a3202f;
    --dmg-ink: #ffffff;
    --dmg-edge: #e8872b;

    --adv-n: #5c3a24;
    --adv-n-edge: #c9a24a;
    --adv-n-ink: #fbf0dc;
    --adv-a: #4aa86a;
    --adv-a-edge: #b4e8c6;
    --adv-a-ink: #04210f;
    --adv-d: #e8704a;
    --adv-d-edge: #ffd0bc;
    --adv-d-ink: #2a0c06;
}

/* ---------- fonts: Alegreya SC for headings, Alegreya Sans for the rest ---------- */
.screen {
    -unity-font-definition: url("/Assets/Fonts/AlegreyaSans-Regular.ttf");
}
.caption,
.total,
.tab__text,
.action__text--primary,
.dialog__title,
.mod__text {
    -unity-font-definition: url("/Assets/Fonts/AlegreyaSC-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 1px;
}
.caption { font-size: 10px; }
.tab__text { font-size: 12px; }
.formula { font-size: 15px; }
.breakdown { font-size: 14px; }

/* ---------- panel frame (9-slice) ---------- */
.set-header,
.chip,
.tabbar,
.dialog__card,
.picker,
.toast {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/UI/Tavla/Ui_TavlaPanel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    border-radius: 0;
}
.chip.pressed {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(215, 180, 150);
}

/* ---------- buttons: dark walnut with a brass line for the quiet ones, apricot for the main one ---------- */
.action--ghost,
.action--danger {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/UI/Tavla/Ui_TavlaButton.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    border-radius: 0;
}
.action--primary {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/UI/Tavla/Ui_TavlaButtonApricot.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    border-radius: 0;
}

/* ---------- tabs: the Roll tab as a round coin ---------- */
.tab { border-radius: 6px 6px 2px 2px; }
.tab--roll,
.tab--roll.tab--active {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/UI/Tavla/Ui_TavlaRollCoin.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(200, 175, 145);
    border-width: 0;
    border-radius: 0;
}
.tab--roll.tab--active { -unity-background-image-tint-color: rgb(255, 255, 255); }
.tab--roll .tab__text { color: #2a1206; }

/* ---------- dice buttons and switches ---------- */
.die-btn {
    background-color: rgba(76, 46, 26, 0.95);
    border-color: var(--btn-edge);
    border-radius: 8px;
}
.die-btn.pressed { background-color: rgba(232, 135, 43, 0.35); }
.switch,
.switch__knob { border-radius: 6px; }
