/* The Presets, History and Settings tabs and the shared dialog. Colours come from the theme (Tavern.uss). */

/* The list tabs hide the 3D tray behind them. */
.safe-area--opaque { background-color: var(--bg); }

.empty-note {
    margin: 40px 30px 0 30px;
    font-size: 15px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.list { flex-grow: 1; }

/* ---------- list rows (presets, history) ---------- */
.list-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 6px;
    padding: 8px 8px 8px 14px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 16px;
}
.list-row.pressed { background-color: var(--btn-edge); }
.list-row__main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.list-row__title {
    font-size: 16px;
    -unity-font-style: bold;
}
.list-row__line {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.list-row__time {
    font-size: 12px;
    color: var(--muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.icon-btn {
    width: 40px;
    height: 40px;
    margin-left: 2px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-radius: 20px;
}
.icon-btn.pressed { background-color: var(--btn-edge); }
.icon-btn__icon {
    width: 20px;
    height: 20px;
    color: var(--text);
}
.icon-btn--danger .icon-btn__icon { color: var(--adv-d); }

/* one rolled set inside a history row */
.hist-set {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 2px;
}
.hist-set__cap {
    width: 64px;
    flex-shrink: 0;
    margin-bottom: 3px;
    font-size: 11px;
    color: var(--muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.hist-set__total {
    min-width: 34px;
    flex-shrink: 0;
    font-size: 20px;
    -unity-font-style: bold;
}
.hist-set__total--nat20 { color: var(--accent); }
.hist-set__total--nat1 { color: var(--adv-d); }
.hist-set__detail {
    flex-shrink: 1;
    margin-left: 6px;
    margin-bottom: 3px;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- settings ---------- */
.setting {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 52px;
    margin-bottom: 6px;
    padding: 0 14px 0 18px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 26px;
}
.setting.pressed { background-color: var(--btn-edge); }
.setting__label { font-size: 16px; }
.setting__value {
    font-size: 15px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* - value + stepper inside a setting row */
.stepper {
    flex-direction: row;
    align-items: center;
}
.stepper__btn {
    width: 36px;
    height: 36px;
    justify-content: center;
    align-items: center;
    background-color: var(--btn);
    border-width: 1.5px;
    border-color: var(--btn-edge);
    border-radius: 18px;
}
.stepper__btn.pressed { background-color: var(--btn-edge); }
.stepper__btn--disabled { opacity: 0.35; }
.stepper__sign {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.stepper__value {
    min-width: 84px;
    -unity-text-align: middle-center;
}

.action--danger {
    margin-top: 10px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--adv-d-edge);
}
.action--danger .action__text {
    margin-left: 0;
    color: var(--adv-d);
}

/* ---------- dialog ---------- */
.dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: var(--scrim);
}
.dialog--open { display: flex; }
.dialog__card {
    width: 88%;
    padding: 18px 16px 16px 16px;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: 22px;
}
.dialog__card--wide { width: 96%; }
.dialog__title {
    margin-bottom: 10px;
    font-size: 20px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.dialog__message {
    margin-bottom: 14px;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.dialog__input { margin: 0 0 14px 0; }
.dialog__input .unity-base-text-field__input {
    height: 44px;
    padding: 0 14px;
    background-color: var(--btn);
    border-width: 1.5px;
    border-color: var(--btn-edge);
    border-radius: 14px;
    color: var(--text);
    font-size: 16px;
    -unity-text-align: middle-left;
}
.dialog__input .unity-base-text-field__input:focus { border-color: var(--accent); }
.dialog__buttons { flex-direction: row; }

/* the preset editor reuses the Roll tab's set panels; nothing is rolled there, so no totals */
.editor-sets { margin-bottom: 10px; }
.editor-sets .total,
.editor-sets .breakdown { display: none; }
.editor-sets .set-header { margin-bottom: 0; }
.dialog__btn-text {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.action--primary .dialog__btn-text { color: var(--accent-ink); }
