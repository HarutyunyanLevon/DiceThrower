/* The Presets, History and Settings tabs and the shared dialog. Colours come from the theme (Tavern.uss). */

/* The list tabs hide the 3D tray behind them. */
.safe-area--opaque { background-color: var(--bg); }

.empty-note {
    margin: 40px 30px 0 30px;
    font-size: 15px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.list { flex-grow: 1; }

/* ---------- list rows (presets, history) ---------- */
.list-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 6px;
    padding: 8px 8px 8px 14px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 16px;
}
.list-row.pressed { background-color: var(--btn-edge); }
.list-row__main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.list-row__title {
    font-size: 16px;
    -unity-font-style: bold;
}
.list-row__line {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.list-row__time {
    font-size: 12px;
    color: var(--muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.icon-btn {
    width: 40px;
    height: 40px;
    margin-left: 2px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-radius: 20px;
}
.icon-btn.pressed { background-color: var(--btn-edge); }
.icon-btn__icon {
    width: 20px;
    height: 20px;
    color: var(--text);
}
.icon-btn--danger .icon-btn__icon { color: var(--adv-d); }

/* one rolled set inside a history row */
.hist-set {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}
.hist-set__cap {
    width: 64px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.hist-set__total {
    min-width: 34px;
    flex-shrink: 0;
    font-size: 20px;
    -unity-font-style: bold;
}
.hist-set__total--nat20 { color: var(--accent); }
.hist-set__total--nat1 { color: var(--adv-d); }
/* formula over breakdown, to the right of the total */
.hist-set__detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 6px;
}
.hist-set__formula,
.hist-set__breakdown {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.hist-set__formula { -unity-font-style: bold; }

/* ---------- settings ---------- */
.setting {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 52px;
    margin-bottom: 6px;
    padding: 0 14px 0 18px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--panel-edge);
    border-radius: 26px;
}
.setting.pressed { background-color: var(--btn-edge); }
.setting__label { font-size: 16px; }
.setting__value {
    font-size: 15px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* - value + stepper inside a setting row */
.stepper {
    flex-direction: row;
    align-items: center;
}
.stepper__btn {
    width: 36px;
    height: 36px;
    justify-content: center;
    align-items: center;
    background-color: var(--btn);
    border-width: 1.5px;
    border-color: var(--btn-edge);
    border-radius: 18px;
}
.stepper__btn.pressed { background-color: var(--btn-edge); }
.stepper__btn--disabled { opacity: 0.35; }
.stepper__sign {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.stepper__value {
    min-width: 84px;
    -unity-text-align: middle-center;
}

.action--danger {
    margin-top: 10px;
    background-color: var(--panel);
    border-width: 1.5px;
    border-color: var(--adv-d-edge);
}
.action--danger .action__text {
    margin-left: 0;
    color: var(--adv-d);
}

/* ---------- theme picker: a sheet over the bottom of the Roll tab, the 3D scene stays visible above it ---------- */
.theme-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    padding: 14px 12px 12px 12px;
    background-color: var(--panel);
    border-top-width: 2px;
    border-color: var(--panel-edge);
}
.theme-sheet--open { display: flex; }
.theme-cards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 10px;
}
.theme-card {
    margin: 4px;
    padding: 8px 12px;
    font-size: 15px;
    color: var(--text);
    background-color: var(--btn);
    border-width: 2px;
    border-color: var(--btn-edge);
    border-radius: 12px;
}
.theme-card--selected {
    color: var(--accent-ink);
    background-color: var(--accent);
    border-color: var(--panel-edge);
}

/* ---------- dialog ---------- */
.dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: var(--scrim);
}
.dialog--open { display: flex; }
.dialog__card {
    width: 88%;
    padding: 18px 16px 16px 16px;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: 22px;
}
.dialog__card--wide { width: 96%; }
.dialog__title {
    margin-bottom: 10px;
    font-size: 20px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.dialog__message {
    margin-bottom: 14px;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.dialog__input { margin: 0 0 14px 0; }
.dialog__input .unity-base-text-field__input {
    height: 44px;
    padding: 0 14px;
    background-color: var(--btn);
    border-width: 1.5px;
    border-color: var(--btn-edge);
    border-radius: 14px;
    color: var(--text);
    font-size: 16px;
    -unity-text-align: middle-left;
}
.dialog__input .unity-base-text-field__input:focus { border-color: var(--accent); }
.dialog__buttons { flex-direction: row; }

/* the preset editor reuses the Roll tab's set panels; nothing is rolled there, so no totals */
.editor-sets { margin-bottom: 10px; }
.editor-sets .total,
.editor-sets .breakdown { display: none; }
.editor-sets .set-header {
    height: 46px;
    margin-bottom: 0;
}
.dialog__btn-text {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.action--primary .dialog__btn-text { color: var(--accent-ink); }

/* ---------- Dice tab: the two slots, the grid of dice sets and the Use buttons ---------- */
.dice-slots {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 6px;
}
.dice-slot {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 3px;
    padding: 8px 6px;
    align-items: center;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: 18px;
}
.dice-slot.dice-row--atk { border-color: var(--atk-edge); }
.dice-slot.dice-row--dmg { border-color: var(--dmg-edge); }
.dice-slot__caption {
    font-size: 11px;
    color: var(--muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.dice-slot__picture {
    width: 116px;
    height: 116px;
    margin: 4px 0;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}
.dice-slot__picture .die-icon {
    width: 96px;
    height: 96px;
}
.dice-slot__name {
    max-width: 100%;
    font-size: 14px;
    color: var(--accent);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dice-grid { flex-grow: 1; }
.dice-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}
.dice-card {
    width: 50%;
    padding: 3px;
}
.dice-card__body {
    flex-grow: 1;
    min-height: 148px;
    padding: 8px 6px;
    align-items: center;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: 16px;
}
.dice-card.pressed .dice-card__body { background-color: var(--btn-edge); }
.dice-card--selected .dice-card__body { border-color: var(--accent); }
.dice-card__picture {
    width: 96px;
    height: 96px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}
.dice-card__picture .die-icon {
    width: 88px;
    height: 88px;
}
.dice-card__name {
    max-width: 100%;
    margin-top: 2px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dice-card__tag {
    margin-top: 3px;
    padding: 1px 8px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 8px;
    background-color: var(--accent);
    color: var(--accent-ink);
}
.dice-card__tag.dice-row--atk { background-color: var(--atk); color: var(--atk-ink); }
.dice-card__tag.dice-row--dmg { background-color: var(--dmg); color: var(--dmg-ink); }

/* nat 20 / nat 1 effect chips, top-right corner of a card whose set has those effects */
.dice-card__fx {
    position: absolute;
    top: 4px;
    right: 4px;
    flex-direction: row;
}
.dice-fx-chip {
    min-width: 26px;
    margin-left: 3px;
    padding: 2px 6px;
    align-items: center;
    border-width: 1px;
    border-radius: 9px;
    background-color: var(--panel);
    border-color: var(--panel-edge);
}
.dice-fx-chip__text {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.dice-fx-chip--nat20 { border-color: var(--accent); }
.dice-fx-chip--nat20 .dice-fx-chip__text { color: var(--accent); }
.dice-fx-chip--nat1 { border-color: var(--dmg); }
.dice-fx-chip--nat1 .dice-fx-chip__text { color: var(--dmg); }
.dice-fx-chip.pressed { background-color: var(--btn-edge); }

/* the dN text is for the dice rows; the big pictures here need none */
.dice-slot .die-icon__text,
.dice-card .die-icon__text { display: none; }

.dice-actions {
    flex-direction: row;
    flex-shrink: 0;
    height: 44px;
    margin-top: 6px;
    margin-bottom: 4px;
}
.dice-use {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 3px;
    border-width: 2px;
    border-color: var(--btn-edge);
}
.dice-use.dice-row--atk { background-color: var(--atk); }
.dice-use.dice-row--dmg { background-color: var(--dmg); }
.dice-use__text {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.dice-use.dice-row--atk .dice-use__text { color: var(--atk-ink); }
.dice-use.dice-row--dmg .dice-use__text { color: var(--dmg-ink); }
